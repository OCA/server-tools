#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_ir_sequence_template_form
msgid ""
"<span colspan=\"2\">Current Year with Century: %(year)s</span>\n"
"                                    <span colspan=\"2\">Current Year without Century: %(y)s</span>\n"
"                                    <span colspan=\"2\">Month: %(month)s</span>\n"
"                                    <span colspan=\"2\">Day: %(day)s</span>"
msgstr ""
"<span colspan=\"2\">Anno corrente con secolo: %(year)s</span>\n"
"                                    <span colspan=\"2\">Anno corrente senza "
"secolo: %(y)s</span>\n"
"                                    <span colspan=\"2\">Mese: %(month)s</"
"span>\n"
"                                    <span colspan=\"2\">Giorno: %(day)s</"
"span>"

#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_ir_sequence_template_form
msgid ""
"<span colspan=\"2\">Day of the Year: %(doy)s</span>\n"
"                                    <span colspan=\"2\">Week of the Year: %(woy)s</span>\n"
"                                    <span colspan=\"2\">Day of the Week (0:Monday): %(weekday)s</span>"
msgstr ""
"<span colspan=\"2\">Giorno dell'anno: %(doy)s</span>\n"
"                                    <span colspan=\"2\">Settimana dell'anno: "
"%(woy)s</span>\n"
"                                    <span colspan=\"2\">Giorno della "
"settimana (0:Lunedì): %(weekday)s</span>"

#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_ir_sequence_template_form
msgid ""
"<span colspan=\"2\">Hour 00-&gt;24: %(h24)s</span>\n"
"                                    <span colspan=\"2\">Hour 00-&gt;12: %(h12)s</span>\n"
"                                    <span colspan=\"2\">Minute: %(min)s</span>\n"
"                                    <span colspan=\"2\">Second: %(sec)s</span>"
msgstr ""
"<span colspan=\"2\">Ora 00-&gt;24: %(h24)s</span>\n"
"                                    <span colspan=\"2\">Ora 00-&gt;12: %(h12)"
"s</span>\n"
"                                    <span colspan=\"2\">Minuto: %(min)s</"
"span>\n"
"                                    <span colspan=\"2\">Secondo: %(sec)s</"
"span>"

#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_ir_sequence_template_form
msgid ""
"<span colspan=\"4\">\n"
"                                        <strong>Company Fields</strong>\n"
"                                    </span>\n"
"                                    <span colspan=\"4\">You can use any company flat field in your prefix or suffix</span>"
msgstr ""
"<span colspan=\"4\">\n"
"                                        <strong>Campi azienda</strong>\n"
"                                    </span>\n"
"                                    <span colspan=\"4\">È possibile "
"utilizzare qualsiasi campo semplice dell'azienda nel prefisso o suffisso</"
"span>"

#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_ir_sequence_template_form
msgid ""
"<span colspan=\"4\">Company ID: %(company_id.id)s</span>\n"
"                                    <span colspan=\"4\">Company Name: %(company_id.name)s</span>\n"
"                                    <span colspan=\"4\">Company Registry: %(company_id.company_registry)s</span>"
msgstr ""
"<span colspan=\"4\">ID azienda: %(company_id.id)s</span>\n"
"                                    <span colspan=\"4\">Nome azienda: %"
"(company_id.name)s</span>\n"
"                                    <span colspan=\"4\">Registro azienda: %"
"(company_id.company_registry)s</span>"

#. module: base_sequence_template
#: model_terms:ir.ui.view,arch_db:base_sequence_template.view_generate_company_sequences_wizard_form
msgid ""
"<strong>Warning:</strong>\n"
"                    Be careful! Generating sequences may override or duplicate\n"
"                    the currently configured sequences for the selected companies.\n"
"                    Only proceed if you know what you are doing."
msgstr ""
"<strong>Attenzione:</strong>\n"
"                    Prestare attenzione! La generazione delle sequenze "
"potrebbe sovrascrivere o duplicare\n"
"                    le sequenze attualmente configurate per le aziende "
"selezionate.\n"
"                    Procedere solo se si è consapevoli di ciò che si sta "
"facendo."

