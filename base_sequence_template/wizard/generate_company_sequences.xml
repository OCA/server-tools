<odoo>
    <record id="view_generate_company_sequences_wizard_form" model="ir.ui.view">
        <field name="name">generate.company.sequences.wizard.form</field>
        <field name="model">generate.company.sequences.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Company Sequences">
                <div class="alert alert-warning mb-4" role="alert">
                    <strong>Warning:</strong>
                    Be careful! Generating sequences may override or duplicate
                    the currently configured sequences for the selected companies.
                    Only proceed if you know what you are doing.
                </div>
                <group>
                    <field
                        name="company_ids"
                        widget="many2many_tags"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field
                        name="template_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                        readonly="1"
                    />
                </group>
                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Confirm"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_generate_company_sequences_wizard" model="ir.actions.act_window">
        <field name="name">Generate Company Sequences</field>
        <field name="res_model">generate.company.sequences.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_generate_company_sequences_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
