<odoo>
    <record id="view_model_form_inherit_ormgraph" model="ir.ui.view">
        <field name="name">ir.model.form.inherit.ormgraph</field>
        <field name="model">ir.model</field>
        <field name="inherit_id" ref="base.view_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_view_ormgraph"
                            type="object"
                            string="Architecture Visualizer"
                            class="btn btn-primary"
                            icon="fa-sitemap"
                            title="Open Interactive ERD &amp; Architecture Visualizer in ORMGraph"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
