<odoo>
    <record id="global_undo_exclusion_view_list" model="ir.ui.view">
        <field name="name">global.undo.exclusion.list</field>
        <field name="model">global.undo.exclusion</field>
        <field name="arch" type="xml">
            <list string="Excluded Models" editable="bottom">
                <field name="model_id" options="{'no_create': True}" />
                <field name="model_name" />
                <field name="reason" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="global_undo_exclusion_action" model="ir.actions.act_window">
        <field name="name">Excluded Models</field>
        <field name="res_model">global.undo.exclusion</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >Exclude a model from the undo history</p>
            <p>Operations on these models are never recorded, on top of the technical
               and ledger models the module always leaves alone.</p>
        </field>
    </record>
</odoo>
