<?xml version="1.0" ?>
<odoo>

   <!-- Views and menus for the new object fetchmail.attachment.condition -->
    <record id="view_fetchmail_attachment_condition_tree" model="ir.ui.view">
        <field name="name">view_fetchmail_attachment_condition_tree</field>
        <field name="model">fetchmail.attachment.condition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="email_from" />
                <field name="email_to" />
                <field name="email_subject" />
                <field name="file_extension" />
                <field name="server_id" invisible="1" />
                <field name="company_id" />
            </tree>
       </field>
    </record>

    <record id="view_fetchmail_attachment_condition_form" model="ir.ui.view">
        <field name="name">view_fetchmail_attachment_condition_form</field>
        <field name="model">fetchmail.attachment.condition</field>
        <field name="arch" type="xml">
            <form string="Attachment Condition requirements">
                <sheet>
                  <div class="oe_title">
                      <label class="oe_edit_only" for="name" />
                      <h1>
                          <field name="name" />
                      </h1>
                  </div>
                    <group string="Requirements" class="col-12 col-lg-6">
                        <field name="company_id" />
                        <field name="email_from" />
                        <field name="email_to" />
                        <field name="email_subject" />
                        <field name="file_extension" />
                    </group>
                    <group string="Attachment process" class="col-12 col-lg-6">
                        <field name="file_type" />
                        <field name="server_id" invisible="1" />
                    </group>
                </sheet>
            </form>
       </field>
    </record>

</odoo>
