<odoo>
    <!-- list View -->
    <record id="view_profiler_result_list" model="ir.ui.view">
        <field name="name">profiler.result.list</field>
        <field name="model">profiler.result</field>
        <field name="arch" type="xml">
            <list string="Profiler Results">
                <field name="create_date" />
                <field name="name" />
                <field name="duration" widget="float_time" />
                <field name="user_id" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_profiler_result_form" model="ir.ui.view">
        <field name="name">profiler.result.form</field>
        <field name="model">profiler.result</field>
        <field name="arch" type="xml">
            <form string="Profiler Result">
                <header>
                    <button
                        name="action_download_pstats"
                        string="Download .pstats"
                        type="object"
                        class="btn-primary"
                        invisible="not stats_binary"
                    />
                    <button
                        name="action_download_callgrind"
                        string="Download callgrind"
                        type="object"
                        invisible="not stats_callgrind"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="duration" widget="float_time" />
                        </group>
                        <group>
                            <field name="create_date" />
                            <field name="user_id" />
                            <field name="stats_binary" invisible="1" />
                            <field name="stats_callgrind" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Flamegraph" name="flamegraph">
                            <field name="flamegraph_html" widget="html" nolabel="1" />
                        </page>
                        <page string="Raw Statistics" name="raw_stats">
                            <group string="Profile Statistics">
                                <field name="stats_text" widget="text" nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_profiler_result_search" model="ir.ui.view">
        <field name="name">profiler.result.search</field>
        <field name="model">profiler.result</field>
        <field name="arch" type="xml">
            <search string="Profiler Results">
                <field name="name" />
                <field name="user_id" />
                <filter
                    string="Today"
                    name="today"
                    domain="[('create_date', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"
                />
                <filter
                    string="Last 7 Days"
                    name="last_7_days"
                    domain="[('create_date', '&gt;=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Function"
                        name="group_by_name"
                        context="{'group_by': 'name'}"
                    />
                    <filter
                        string="User"
                        name="group_by_user"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        string="Date"
                        name="group_by_date"
                        context="{'group_by': 'create_date:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_profiler_result" model="ir.actions.act_window">
        <field name="name">Profiler Results</field>
        <field name="res_model">profiler.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_last_7_days': 1}</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_profiler_root"
        name="Profiler"
        parent="base.menu_administration"
        sequence="100"
    />
    <menuitem
        id="menu_profiler_results"
        name="Profiler Results"
        parent="menu_profiler_root"
        action="action_profiler_result"
        sequence="10"
    />
</odoo>
