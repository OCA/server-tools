<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="remote_odoo_instance_view_list" model="ir.ui.view">
        <field name="name">remote.odoo.instance.list</field>
        <field name="model">remote.odoo.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="url" />
                <field name="database" />
                <field name="username" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="remote_odoo_instance_view_form" model="ir.ui.view">
        <field name="name">remote.odoo.instance.form</field>
        <field name="model">remote.odoo.instance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" placeholder="https://example.odoo.com" />
                            <field name="database" />
                        </group>
                        <group>
                            <field name="username" />
                            <field name="password" password="True" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="remote_odoo_instance_view_search" model="ir.ui.view">
        <field name="name">remote.odoo.instance.search</field>
        <field name="model">remote.odoo.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="url" />
                <field name="database" />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="remote_odoo_instance_action" model="ir.actions.act_window">
        <field name="name">Remote Instances</field>
        <field name="res_model">remote.odoo.instance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
