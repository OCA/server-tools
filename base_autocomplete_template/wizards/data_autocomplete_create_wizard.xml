<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_data_wizard_template_create_form" model="ir.ui.view">
        <field name="name">data.wizard.template.create.form</field>
        <field name="model">data.wizard.template.create</field>
        <field name="arch" type="xml">
            <form string="Save as Template">
                <group>
                    <field name="name" placeholder="e.g. Monthly Close - Default" />
                    <field name="model_id" readonly="1" />
                    <field name="company_id" />
                    <field name="is_personal" />
                </group>
                <footer>
                    <button
                        string="Save"
                        type="object"
                        name="action_create_template"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
