<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purge_attachments_view" model="ir.ui.view">
        <field name="model">cleanup.purge.wizard.attachment</field>
        <field name="inherit_id" ref="form_purge_wizard" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="attachment_id" />
                <field name="reason" />
            </field>
        </field>
    </record>

    <record id="action_purge_attachments" model="ir.actions.server">
        <field name="name">Purge orphaned attachments</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field
            name="model_id"
            ref="database_cleanup.model_cleanup_purge_wizard_attachment"
        />
        <field name="code">
            action = env.get('cleanup.purge.wizard.attachment').get_wizard_action()
        </field>
    </record>

    <record id="purge_attachment_line_tree" model="ir.ui.view">
        <field name="model">cleanup.purge.line.attachment</field>
        <field name="inherit_id" ref="tree_purge_line" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="attachment_id" />
                <field name="reason" />
                <field name="error_message" optional="hide" />
            </field>
        </field>
    </record>

    <record id="action_purge_attachment_line" model="ir.actions.server">
        <field name="name">Purge</field>
        <field name="type">ir.actions.server</field>
        <field name="state">code</field>
        <field
            name="model_id"
            ref="database_cleanup.model_cleanup_purge_line_attachment"
        />
        <field name="code">records.purge()</field>
        <field
            name="binding_model_id"
            ref="database_cleanup.model_cleanup_purge_line_attachment"
        />
    </record>
</odoo>
