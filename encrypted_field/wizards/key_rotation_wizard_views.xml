<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_key_rotation_wizard_form" model="ir.ui.view">
        <field name="name">pb.key.rotation.wizard.form</field>
        <field name="model">pb.key.rotation.wizard</field>
        <field name="arch" type="xml">
            <form string="Key Rotation">
                <div invisible="state != 'draft'">
                    <p class="text-muted">
                        The current encryption key will be read from your odoo.conf.
                        A new key has been auto-generated below.
                    </p>
                    <group>
                        <field name="new_key" password="True" />
                        <field name="generate_new_key" />
                    </group>
                </div>

                <div invisible="state != 'preview'" class="mt-3">
                    <pre><field name="preview_info" nolabel="1" readonly="1" /></pre>
                </div>

                <div invisible="state != 'done'" class="mt-3">
                    <pre><field name="result_info" nolabel="1" readonly="1" /></pre>
                </div>

                <field name="state" invisible="1" />

                <footer>
                    <button
                        string="Preview"
                        name="action_preview"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Rotate Keys"
                        name="action_rotate"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'preview'"
                        confirm="This will re-encrypt all data with the new key. This cannot be undone. Continue?"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_key_rotation_wizard" model="ir.actions.act_window">
        <field name="name">Rotate Encryption Key</field>
        <field name="res_model">pb.key.rotation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
