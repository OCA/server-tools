<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="base_limit_view_list" model="ir.ui.view">
        <field name="model">base.limit.records_number</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name" />
                <field name="model_id" />
                <field name="max_records" />
                <field name="domain" />
            </list>
        </field>
    </record>
    <record id="base_limit_view_form" model="ir.ui.view">
        <field name="model">base.limit.records_number</field>
        <field name="arch" type="xml">
            <form string="Records Number">
                <sheet>
                    <group col="3">
                        <field name="name" />
                        <field name="model_id" />
                        <field name="max_records" />
                        <field name="domain" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="base_limit_view_search" model="ir.ui.view">
        <field name="model">base.limit.records_number</field>
        <field name="arch" type="xml">
            <search string="Records Number">
                <filter
                    string="Unlimited Table"
                    name="max_records"
                    domain="[('max_records','in',[0, False])]"
                />
                <field name="name" />
                <field name="model_id" />
            </search>
        </field>
    </record>
    <record id="base_limit_records_number_action" model="ir.actions.act_window">
        <field name="name">Records Number Limits</field>
        <field name="res_model">base.limit.records_number</field>
        <field name="path">records-number-limits</field>
        <field name="view_mode">list,form,search</field>
    </record>
    <menuitem
        action="base_limit_records_number_action"
        id="menu_base_limit_records_number"
        parent="base.menu_security"
        groups="access_limit_records_number.group_control_limits_on_records_number"
    />
</odoo>
