<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Change Mail Password Wizard -->
    <record id="mail_password_change_wizard_form" model="ir.ui.view">
        <field name="name">mail.password.change.wizard.form</field>
        <field name="model">mail.password.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Mail Password">
                <!-- Step 1: Verify Identity -->
                <group invisible="state != 'verify'">
                    <div class="alert alert-info" role="alert">
                        <strong>Security Verification</strong><br />
                        Please enter your Odoo password to verify your identity before changing your mail password.
                    </div>
                    <group>
                        <field
                            name="current_odoo_password"
                            password="True"
                            required="1"
                        />
                    </group>
                </group>

                <!-- Step 2: Change Password -->
                <group invisible="state != 'change'">
                    <div class="alert alert-success" role="alert">
                        <strong>Identity Verified</strong><br />
                        You can now set a new password for your mail account.
                        Leave the fields empty to auto-generate a secure password.
                    </div>
                    <group>
                        <field name="new_mail_password" password="True" />
                        <field
                            name="confirm_mail_password"
                            password="True"
                            invisible="not new_mail_password"
                        />
                    </group>
                </group>

                <!-- Step 3: Done - Show Password -->
                <group invisible="state != 'done'">
                    <div class="alert alert-warning" role="alert">
                        <strong>Important!</strong><br />
                        Copy and save this password now. It will not be shown again.
                        Use this password to configure your email client (Thunderbird, Outlook, etc.).
                    </div>
                    <group>
                        <field
                            name="generated_password"
                            widget="CopyClipboardChar"
                            readonly="1"
                        />
                    </group>
                </group>

                <field name="state" invisible="1" />
                <field name="mail_account_id" invisible="1" />

                <footer>
                    <button
                        name="action_verify_password"
                        type="object"
                        string="Verify Identity"
                        class="btn-primary"
                        invisible="state != 'verify'"
                    />
                    <button
                        name="action_change_password"
                        type="object"
                        string="Change Password"
                        class="btn-primary"
                        invisible="state != 'change'"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Close"
                        class="btn-primary"
                        invisible="state != 'done'"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        invisible="state == 'done'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_mail_password_change_wizard" model="ir.actions.act_window">
        <field name="name">Change Mail Password</field>
        <field name="res_model">mail.password.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
