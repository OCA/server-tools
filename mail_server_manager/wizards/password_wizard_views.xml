<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Password Display Wizard Form -->
    <record id="mail_server_manager_password_wizard_form" model="ir.ui.view">
        <field name="name">mail.server.password.wizard.form</field>
        <field name="model">mail.server.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Password Generated">
                <div class="alert alert-warning" role="alert">
                    <strong
                >⚠️ Important:</strong> This password will only be shown once.
                    Please copy it now and store it securely.
                </div>
                <group>
                    <field name="email" readonly="1" />
                    <field
                        name="password"
                        widget="CopyClipboardChar"
                        readonly="1"
                        class="text-monospace font-weight-bold"
                    />
                </group>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record
        id="mail_server_manager_action_password_wizard"
        model="ir.actions.act_window"
    >
        <field name="name">Password Generated</field>
        <field name="res_model">mail.server.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
