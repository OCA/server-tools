    <record
        id="demo_user_mail_2"
        model="res.users"
        context="{'no_reset_password': True}"
    >
        <field name="name">Demo Mail User 2</field>
        <field name="login">demo_mail_user_2</field>
        <field name="email">demo2@personal.com</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]" />
    </record>

