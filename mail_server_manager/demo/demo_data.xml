        id="demo_user_mail_1"
        model="res.users"
        context="{'no_reset_password': True}"
    >
        <field name="name">Demo Mail User 1</field>
        <field name="login">demo_mail_user_1</field>
        <field name="email">demo1@personal.com</field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]" />
