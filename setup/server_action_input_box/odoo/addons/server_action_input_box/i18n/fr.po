#. module: server_action_input_box
#: code:addons/server_action_input_box/models/server_action_input_box.py:0
#, python-format
msgid ""
"# ---Predefined Variables--- #\n"
"# All variables allowed in a server action such as:\n"
"#  - env: Odoo environment in which the action is triggered.\n"
"#  - model: Odoo model of the record on which the action is triggered.\n"
"#  - record: record on which the action is triggered.\n"
"#  - records: set of records on which the action is triggered.\n"
"#  - time, datetime, dateutil, timezone: useful Python libraries.\n"
"#  - log(message, level='info'): logging function to log debugging information in the ir.logging table.\n"
"#  - UserError: Exception warning for use with raise.\n"
"#  - To return an action, assign: action = {...}\n"
"# Variable names: configured in the 'Unique Name' field.\n"
"#  - These will contain the value entered in the input box.\n"
"#  - Indicates the data type: 'string', 'int', 'float' 'boolean'.\n"
"#  - Input lists, tuples, sets, and dictionaries as 'string' and perform the conversion in your code.\n"
"\n"
"\n"
"\n"
msgstr ""
"# ---Variables prédéfinies--- #\n"
"# Toutes les variables autorisées dans une action serveur, telles que :\n"
"#  - env : Environnement Odoo dans lequel l'action est déclenchée.\n"
"#  - model : Modèle Odoo de l'enregistrement sur lequel l'action est déclenchée.\n"
"#  - record : Enregistrement sur lequel l'action est déclenchée.\n"
"#  - records : Ensemble d'enregistrements sur lesquels l'action est déclenchée.\n"
"#  - time, datetime, dateutil, timezone : Bibliothèques Python utiles.\n"
"#  - log(message, level='info') : Fonction de journalisation pour enregistrer des informations de débogage dans la table ir.logging.\n"
"#  - UserError : Avertissement d'exception à utiliser avec raise.\n"
"#  - Pour retourner une action, attribuez : action = {...}\n"
"# Noms des variables : configurés dans le champ 'Nom unique'.\n"
"#  - Ces variables contiendront la valeur saisie dans la boîte de saisie.\n"
"#  - Indique le type de données : 'string', 'int', 'float', 'boolean'.\n"
"#  - Saisissez les listes, tuples, ensembles et dictionnaires comme 'string' et effectuez la conversion dans votre code.\n"
"\n"
"\n"
"\n"

